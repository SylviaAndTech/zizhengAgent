# 复制成 infra/.env 并改掉所有密码后使用：cp .env.example .env
# 这个文件只管数据库容器自己的初始化参数；应用连数据库用的账号密码在 app/.env 里，两边要对上。
#
# 注意：MYSQL_* 这几个变量只在 MySQL 数据目录为空（第一次启动）时生效，用来初始化库和账号。
# 之后再改这里的值不会修改已存在的密码——那种情况得进容器执行 ALTER USER，或者清掉
# data/mysql 重新初始化（会丢数据，慎用）。

# root 账号密码，healthcheck 也会用到
MYSQL_ROOT_PASSWORD=change_me_root_password

# 业务库名，要跟 app/.env 里的 DB_NAME 一致
MYSQL_DATABASE=sizheng_cases

# 业务账号，要跟 app/.env 里的 DB_USER / DB_PASSWORD 一致
MYSQL_USER=sizheng
MYSQL_PASSWORD=change_me_app_password
