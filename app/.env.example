# 复制成 app/.env 后填写：cp .env.example .env
# 这些变量通过 compose 的 env_file 注入 api 容器。

# ==================== 大模型 ====================
# 硅基流动（SiliconFlow）的 API Key。变量名是历史遗留（最早接的是阿里云 DashScope，
# 后来换成硅基流动的 OpenAI 兼容协议但变量名没改），实际要去 https://cloud.siliconflow.cn 申请，
# 不是阿里云控制台
DASHSCOPE_API_KEY=

# 对话/结构化字段生成用的模型
QWEN_MODEL=deepseek-ai/DeepSeek-V4-Flash
# 案例正文写作/修订专用的更强模型（更贵更慢，只用在最吃文笔的写作-评审循环）
QWEN_NARRATIVE_MODEL=deepseek-ai/DeepSeek-V4-Pro
# 向量模型，知识点↔案例语义匹配用
QWEN_EMBEDDING_MODEL=Qwen/Qwen3-Embedding-8B
# 扫描版大纲整页 OCR 兜底用的视觉模型
QWEN_VISION_MODEL=Qwen/Qwen3-VL-8B-Instruct
# AI助手一轮对话最多允许的工具调用轮次
QWEN_MAX_TOOL_ROUNDS=6
# 案例正文写作-评审循环最大轮次，调大更精细但更耗时耗成本
CASE_NARRATIVE_MAX_ITERATIONS=2
# 后台任务线程池并发数（案例生成等慢任务）
MAX_CONCURRENT_GENERATION_JOBS=2

# ==================== MySQL ====================
# 主机名填 compose 的服务名，不要填 IP——容器 IP 每次重启都会变，
# Docker 内置 DNS 会把服务名解析到当前正确的容器
DB_HOST=mysql
DB_PORT=3306
# 下面三个要跟 infra/.env 里的 MYSQL_USER / MYSQL_PASSWORD / MYSQL_DATABASE 完全一致
DB_USER=sizheng
DB_PASSWORD=change_me_app_password
DB_NAME=sizheng_cases

# ==================== ChromaDB ====================
CHROMA_HOST=chroma
# 【注意】这里必须是 8000，不是 8001。
# 8001 是本地开发时 docker-compose 把 chroma 映射到宿主机用的端口；
# 容器之间直接通信走的是容器内实际监听的端口，chroma 内部固定监听 8000
CHROMA_PORT=8000

# ==================== 登录鉴权 ====================
# 生产必须是 true。设成 false 会关掉全部接口的登录校验，等于把后台完全公开
AUTH_ENABLED=true
# 首次启动自动创建的 admin 账号密码。账号已存在时改这里不会覆盖已有密码，
# 只在第一次初始化时生效——所以第一次部署前就要改成强密码
AUTH_DEFAULT_ADMIN_PASSWORD=change_me_admin_password
# 登录会话有效期（小时），默认 7 天
AUTH_SESSION_TTL_HOURS=168

# ==================== 其他 ====================
# CORS：生产环境不要设这个变量。nginx 让前端和 /api 同源，压根不需要 CORS；
# 只有"不走 nginx、直接 uvicorn + 独立静态服务器"的本地调试才需要，格式是逗号分隔的来源列表
# CORS_ORIGINS=http://localhost:5500

# FastAPI 的 root_path，告诉 Swagger 自己挂在哪个前缀下。
# 默认就是 /api，跟 nginx 的反代规则配套，一般不用改
# ROOT_PATH=/api
