# 复制为 .env 并填入你自己的密钥，.env 不会被提交到版本控制

# 阿里云 DashScope 的 API Key（用于调用 Qwen 系列模型，含对话生成与文本向量）
# 获取方式：https://dashscope.console.aliyun.com/apiKey
DASHSCOPE_API_KEY=

# 对话/生成用的模型，需要支持 function calling，建议 qwen-plus 或 qwen-max
QWEN_MODEL=qwen-plus

# 文本向量模型，用于知识点与案例的语义相似度匹配
QWEN_EMBEDDING_MODEL=text-embedding-v3

# AI助手一轮对话里最多允许的工具调用轮次，避免死循环
QWEN_MAX_TOOL_ROUNDS=6

# ---- MySQL（关系数据：素材/案例/知识点/会话/审计日志）----
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=sizheng
DB_PASSWORD=sizheng_pass
DB_NAME=sizheng_cases

# ---- ChromaDB（知识点描述/素材切块的向量库，用于向量粗筛）----
CHROMA_HOST=127.0.0.1
CHROMA_PORT=8001

# ---- 登录鉴权 ----
# 是否要求登录才能访问接口。测试阶段可以设成false整体跳过登录，方便联调；
# 正式上线前务必确认是true（默认值就是true，不配置这一行也行）
AUTH_ENABLED=true
# 首次启动时会自动创建这个默认管理员账号（用户名固定是admin，密码取这里的值）；
# 账号一旦已经存在，改这个值不会覆盖数据库里已有的密码，只在账号不存在时生效
AUTH_DEFAULT_ADMIN_PASSWORD=Wzlg123456
# 登录会话的有效期（小时），默认7天，过期后需要重新登录
AUTH_SESSION_TTL_HOURS=168
