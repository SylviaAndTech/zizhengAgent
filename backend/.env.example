# 复制为 .env 并填入你自己的密钥，.env 不会被提交到版本控制

# 硅基流动（SiliconFlow）的 API Key（用于调用大模型，含对话生成与文本向量）。
# 变量名是历史遗留——最早接的是阿里云原生DashScope，后来换成了硅基流动的OpenAI兼容协议，
# 但变量名没跟着改，实际要去 https://cloud.siliconflow.cn 申请key，不是阿里云控制台
DASHSCOPE_API_KEY=

# 对话/结构化字段生成用的模型，需要支持function calling
QWEN_MODEL=deepseek-ai/DeepSeek-V4-Flash

# 案例正文写作/修订专用的更强模型（更贵更慢，只用在最吃文笔的正文写作-评审循环上）
QWEN_NARRATIVE_MODEL=deepseek-ai/DeepSeek-V4-Pro

# 文本向量模型，用于知识点与案例的语义相似度匹配
QWEN_EMBEDDING_MODEL=Qwen/Qwen3-Embedding-8B

# 扫描版教学大纲整页OCR兜底用的视觉模型（Tesseract识别不了的场景才会用到）
QWEN_VISION_MODEL=Qwen/Qwen3-VL-8B-Instruct

# AI助手一轮对话里最多允许的工具调用轮次，避免死循环
QWEN_MAX_TOOL_ROUNDS=6

# 案例正文写作-评审循环（写作者→评审者→修订者）的最大轮次，调大更精细但更耗时耗成本
CASE_NARRATIVE_MAX_ITERATIONS=2

# ---- MySQL（关系数据：素材/案例/知识点/会话/审计日志）----
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=sizheng
DB_PASSWORD=sizheng_pass
DB_NAME=sizheng_cases

# ---- ChromaDB（知识点描述/素材切块的向量库，用于向量粗筛）----
CHROMA_HOST=127.0.0.1
CHROMA_PORT=8001

# ---- 登录鉴权 ----
# 是否要求登录才能访问接口。测试阶段可以设成false整体跳过登录，方便联调；
# 正式上线前务必确认是true（默认值就是true，不配置这一行也行）
AUTH_ENABLED=true
# 首次启动时会自动创建这个默认管理员账号（用户名固定是admin，密码取这里的值）；
# 账号一旦已经存在，改这个值不会覆盖数据库里已有的密码，只在账号不存在时生效
AUTH_DEFAULT_ADMIN_PASSWORD=Wzlg123456
# 登录会话的有效期（小时），默认7天，过期后需要重新登录
AUTH_SESSION_TTL_HOURS=168
